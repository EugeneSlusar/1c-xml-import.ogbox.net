Перем ПоследниеДанные;

&НаКлиенте
Процедура ВыбратьXML(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Заголовок = "Выберите XML-файл УПД";
	Диалог.Фильтр = "XML-файлы (*.xml)|*.xml";
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораXML", ЭтотОбъект);
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьНастройкиУТ(Команда)
	ПолучитьНастройкиУТНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПолучитьНастройкиУТНаСервере()
	Если Метаданные.Документы.Найти("РеализацияТоваровУслуг") = Неопределено Тогда
		ТекстРезультата = "Команда доступна только в УТ 11.5.";
		Возврат;
	КонецЕсли;
	ТекстРезультата = "Настройки УТ (первые элементы справочников):" + Символы.ПС;
	ВывестиНастройкиСправочника("Организации", "Организации");
	ВывестиНастройкиСправочника("Партнеры", "Партнеры");
	ВывестиНастройкиСправочника("Контрагенты", "Контрагенты");
	ВывестиНастройкиСправочника("Склады", "Склады");
	ВывестиНастройкиСправочника("СоглашенияСКлиентами", "Соглашения с клиентами");
КонецПроцедуры

&НаСервере
Процедура ВывестиНастройкиСправочника(ИмяМенеджера, Заголовок)
	Попытка
		Менеджер = Справочники[ИмяМенеджера];
		Выборка = Менеджер.Выбрать();
		ТекстРезультата = ТекстРезультата + Заголовок + ":" + Символы.ПС;
		Счетчик = 0;
		Пока Выборка.Следующий() И Счетчик < 20 Цикл
			ТекстРезультата = ТекстРезультата + "- " + Выборка.Наименование + Символы.ПС;
			Счетчик = Счетчик + 1;
		КонецЦикла;
	Исключение
		ТекстРезультата = ТекстРезультата + Заголовок + ": справочник не найден" + Символы.ПС;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОбщийТовар(Команда)
	СоздатьОбщийТоварНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьОбщийТоварНаСервере()
	Если Метаданные.Документы.Найти("РеализацияТоваровУслуг") = Неопределено Тогда
		ТекстРезультата = "Создание общего товара поддерживается только в 1С:Управление торговлей 11.5.";
		Возврат;
	КонецЕсли;
	Если Метаданные.Справочники.Найти("Номенклатура") = Неопределено Тогда
		ТекстРезультата = "Справочник Номенклатура в этой конфигурации не найден.";
		Возврат;
	КонецЕсли;
	Попытка
		СсылкаТовара = Справочники.Номенклатура.НайтиПоНаименованию("Товар из УПД", Истина);
		Если Не СсылкаТовара.Пустая() Тогда
			ТекстРезультата = "Общий товар уже существует: Товар из УПД";
			Возврат;
		КонецЕсли;
		НовыйТовар = Справочники.Номенклатура.СоздатьЭлемент();
		НовыйТовар.Наименование = "Товар из УПД";
		НовыйТовар.Записать();
		ТекстРезультата = "Создан общий товар: Товар из УПД";
	Исключение
		ТекстРезультата = "Не удалось создать общий товар:" + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораXML(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ИмяФайла = ВыбранныеФайлы[0];
		ДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);
		АдресФайла = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);
		АдресПоследнегоXML = ИмяФайла;
		ПрочитатьXMLНаСервере(АдресФайла, ИмяФайла);
	Исключение
		ТекстРезультата = "Ошибка выбора XML:" + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЧерновикРеализации(Команда)
	СсылкаДокумента = СоздатьЧерновикРеализацииНаСервере();
	Если ЗначениеЗаполнено(СсылкаДокумента) Тогда
		ОткрытьЗначение(СсылкаДокумента);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПолучитьСтавкуНДСДляУПД(ТекстСтавки)
	СтавкаXML = НРег(СокрЛП(Строка(ТекстСтавки)));
	ДоступныеСтавки = "";
	МетаданныеСтавок = Метаданные.Перечисления.Найти("СтавкиНДС");
	Если МетаданныеСтавок = Неопределено Тогда
		ВызватьИсключение "Перечисление ставок НДС в УТ не найдено.";
	КонецЕсли;
	Для каждого МетаданныеСтавки Из МетаданныеСтавок.ЗначенияПеречисления Цикл
		ПредставлениеСтавки = НРег(СокрЛП(Строка(МетаданныеСтавки.Синоним)));
		Если Не ПустаяСтрока(ДоступныеСтавки) Тогда
			ДоступныеСтавки = ДоступныеСтавки + ", ";
		КонецЕсли;
		ДоступныеСтавки = ДоступныеСтавки + Строка(МетаданныеСтавки.Синоним);
		Если ПредставлениеСтавки = СтавкаXML Тогда
			Возврат Перечисления.СтавкиНДС[МетаданныеСтавки.Имя];
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Ставка НДС «" + Строка(ТекстСтавки) + "» не найдена в УТ. Доступные значения: " + ДоступныеСтавки;
КонецФункции

&НаСервере
Функция ПолучитьНалогообложениеНДСДляУПД(Данные)
	ТребуетсяЛьготноеНалогообложение = Ложь;
	Для каждого СтрокаXML Из Данные.Items Цикл
		СтавкаXML = НРег(СокрЛП(Строка(СтрокаXML.VATRate)));
		Если СтавкаXML = "5%" Или СтавкаXML = "7%" Тогда
			ТребуетсяЛьготноеНалогообложение = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ТребуетсяЛьготноеНалогообложение Тогда
		Возврат ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС");
	КонецЕсли;

	МетаданныеПеречисления = Метаданные.Перечисления.Найти("ТипыНалогообложенияНДС");
	Если МетаданныеПеречисления <> Неопределено Тогда
		Для каждого ЗначениеПеречисления Из МетаданныеПеречисления.ЗначенияПеречисления Цикл
			СинонимЗначения = НРег(Строка(ЗначениеПеречисления.Синоним));
			Если СтрНайти(СинонимЗначения, "льгот") > 0 Тогда
				Возврат ПредопределенноеЗначение("Перечисление.ТипыНалогообложенияНДС." + ЗначениеПеречисления.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	ВызватьИсключение "В УТ не найдено значение «Льготное налогообложение НДС на УСН», необходимое для ставки НДС 5% или 7%.";
КонецФункции

&НаСервере
Функция СоздатьЧерновикРеализацииНаСервере()
	Если Метаданные.Документы.Найти("РеализацияТоваровУслуг") = Неопределено Тогда
		ТекстРезультата = "Создание реализации доступно только в УТ 11.5.";
		Возврат Неопределено;
	КонецЕсли;
	Если ПустаяСтрока(АдресПоследнегоXML) Тогда
		ТекстРезультата = "Сначала выберите XML УПД.";
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Данные = РеквизитФормыВЗначение("Объект").РазобратьXMLИзФайла(АдресПоследнегоXML);
		Организация = Справочники.Организации.НайтиПоРеквизиту("ИНН", Данные.Seller.INN);
		Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", Данные.Buyer.INN);
		Партнер = Справочники.Партнеры.НайтиПоНаименованию(Данные.Buyer.Name, Истина);
		Товар = Справочники.Номенклатура.НайтиПоНаименованию("Товар из УПД", Истина);
		Если Организация.Пустая() Тогда ВызватьИсключение "Организация с ИНН " + Данные.Seller.INN + " не найдена."; КонецЕсли;
		Если Контрагент.Пустая() Тогда ВызватьИсключение "Контрагент с ИНН " + Данные.Buyer.INN + " не найден."; КонецЕсли;
		Если Партнер.Пустая() Тогда ВызватьИсключение "Партнёр " + Данные.Buyer.Name + " не найден."; КонецЕсли;
		Если Товар.Пустая() Тогда ВызватьИсключение "Общий товар «Товар из УПД» не найден."; КонецЕсли;
		ОбъектКонтрагента = Контрагент.ПолучитьОбъект();
		ОбъектКонтрагента.ЮридическоеФизическоеЛицо = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо");
		Попытка ОбъектКонтрагента.Партнер = Партнер; Исключение КонецПопытки;
		ОбъектКонтрагента.Записать();
		ВыборкаСкладов = Справочники.Склады.Выбрать();
		Если Не ВыборкаСкладов.Следующий() Тогда ВызватьИсключение "В УТ нет склада."; КонецЕсли;
		Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		Документ.Дата = ТекущаяДата();
		Документ.ХозяйственнаяОперация = ПредопределенноеЗначение("Перечисление.ХозяйственныеОперации.РеализацияКлиенту");
		Документ.НалогообложениеНДС = ПолучитьНалогообложениеНДСДляУПД(Данные);
		Документ.Организация = Организация;
		Документ.Партнер = Партнер;
		Документ.Контрагент = Контрагент;
		Попытка Документ.КлиентПартнер = Партнер; Исключение КонецПопытки;
		Попытка Документ.КлиентКонтрагент = Контрагент; Исключение КонецПопытки;
		Документ.Склад = ВыборкаСкладов.Ссылка;
		Документ.ЦенаВключаетНДС = Истина;
		Для каждого СтрокаXML Из Данные.Items Цикл
			СтрокаДокумента = Документ.Товары.Добавить();
			СтрокаДокумента.Номенклатура = Товар;
			СтрокаДокумента.КоличествоУпаковок = СтрокаXML.Quantity;
			СтрокаДокумента.Количество = СтрокаXML.Quantity;
			СтрокаДокумента.Цена = СтрокаXML.XmlPrice;
			СтрокаДокумента.Сумма = СтрокаXML.AmountWithoutVAT;
			СтрокаДокумента.СуммаНДС = СтрокаXML.VATAmount;
			СтрокаДокумента.СуммаСНДС = СтрокаXML.AmountWithVAT;
			// Ставку задаём последней: УТ пересчитывает её при изменении цены и сумм.
			СтрокаДокумента.СтавкаНДС = ПолучитьСтавкуНДСДляУПД(СтрокаXML.VATRate);
		КонецЦикла;
		// Первая запись выполняет штатную инициализацию УТ и присваивает номер.
		Документ.Записать();

		// Обработчики первой записи могут заменить ставку настройкой общего товара.
		// Возвращаем значения XML в уже инициализированный документ и сохраняем их
		// без повторного автоматического заполнения со стороны УТ.
		СохраненныйДокумент = Документ.Ссылка.ПолучитьОбъект();
		СохраненныйДокумент.НалогообложениеНДС = ПолучитьНалогообложениеНДСДляУПД(Данные);
		ИндексСтроки = 0;
		Для каждого СтрокаXML Из Данные.Items Цикл
			СохраненнаяСтрока = СохраненныйДокумент.Товары[ИндексСтроки];
			СохраненнаяСтрока.СтавкаНДС = ПолучитьСтавкуНДСДляУПД(СтрокаXML.VATRate);
			ИндексСтроки = ИндексСтроки + 1;
		КонецЦикла;
		СохраненныйДокумент.ОбменДанными.Загрузка = Истина;
		СохраненныйДокумент.Записать();

		СохраненныйДокумент = Документ.Ссылка.ПолучитьОбъект();
		ДиагностикаНДС = "Налогообложение НДС: " + Строка(СохраненныйДокумент.НалогообложениеНДС) + Символы.ПС;
		НомерСтроки = 0;
		Для каждого СохраненнаяСтрока Из СохраненныйДокумент.Товары Цикл
			НомерСтроки = НомерСтроки + 1;
			ДиагностикаНДС = ДиагностикаНДС + "Ставка НДС строки " + Строка(НомерСтроки) + ": "
				+ Строка(СохраненнаяСтрока.СтавкаНДС)
				+ "; тип: " + Строка(ТипЗнч(СохраненнаяСтрока.СтавкаНДС))
				+ "; XML: " + XMLСтрока(СохраненнаяСтрока.СтавкаНДС) + Символы.ПС;
		КонецЦикла;
		ТекстРезультата = "Черновик реализации создан." + Символы.ПС + "Номер: " + Документ.Номер + Символы.ПС + "Дата: " + Формат(Документ.Дата, "ДФ=dd.MM.yyyy HH:mm:ss") + Символы.ПС + "Ссылка: " + Строка(Документ.Ссылка) + Символы.ПС + ДиагностикаНДС + "Документ не проведён.";
		Возврат Документ.Ссылка;
	Исключение
		ТекстРезультата = "Не удалось создать черновик реализации:" + Символы.ПС + ОписаниеОшибки();
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервере
Процедура ПрочитатьXMLНаСервере(АдресФайла, ИмяФайла)
	Попытка
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		Данные = ОбработкаОбъект.РазобратьXMLИзВременногоХранилища(АдресФайла);
		ПоследниеДанные = Данные;
		ИННПродавца = Данные.Seller.INN;
	ИННПокупателя = Данные.Buyer.INN;
	НаименованиеПокупателя = Данные.Buyer.Name;
		ТекстРезультата = "XML прочитан успешно" + Символы.ПС;
		ТекстРезультата = ТекстРезультата + "Документ: №" + Данные.Document.DocumentNumber + Символы.ПС;
		ТекстРезультата = ТекстРезультата + "Продавец: " + Данные.Seller.Name + " (ИНН " + Данные.Seller.INN + ")" + Символы.ПС;
		ТекстРезультата = ТекстРезультата + "Покупатель: " + Данные.Buyer.Name + " (ИНН " + Данные.Buyer.INN + ")" + Символы.ПС;
		ТекстРезультата = ТекстРезультата + "Грузоотправитель: " + Данные.Shipper.Name + " (ИНН " + Данные.Shipper.INN + ")" + Символы.ПС;
		ТекстРезультата = ТекстРезультата + "Грузополучатель: " + Данные.Consignee.Name + " (ИНН " + Данные.Consignee.INN + ")" + Символы.ПС;
		ТекстРезультата = ТекстРезультата + "Адрес продавца: " + Данные.Seller.Address + Символы.ПС;
		ТекстРезультата = ТекстРезультата + "Адрес грузополучателя: " + Данные.Consignee.Address + Символы.ПС;
		ТекстРезультата = ТекстРезультата + "Банк продавца: " + Данные.Seller.BankName + ", счёт " + Данные.Seller.BankAccount + Символы.ПС;
		ТекстРезультата = ТекстРезультата + "Строк товаров: " + Данные.Items.Количество() + Символы.ПС + Символы.ПС;
		Для каждого СтрокаТовара Из Данные.Items Цикл
			ТекстРезультата = ТекстРезультата + Строка(СтрокаТовара.LineNumber) + ". " + СтрокаТовара.Name + "; количество: " + Строка(СтрокаТовара.Quantity) + "; сумма: " + Строка(СтрокаТовара.AmountWithVAT) + Символы.ПС;
		КонецЦикла;
		ТекстРезультата = ТекстРезультата + Символы.ПС + "Итого с НДС: " + Строка(Данные.Totals.AmountWithVAT);
		ТекстРезультата = ТекстРезультата + Символы.ПС + Символы.ПС + "ПРОВЕРКА ДАННЫХ:" + Символы.ПС;
		Если Данные.Errors.Количество() = 0 Тогда
			ТекстРезультата = ТекстРезультата + "Обязательные поля заполнены: OK";
		Иначе
			Для каждого Ошибка Из Данные.Errors Цикл
				ТекстРезультата = ТекстРезультата + "- " + Ошибка + Символы.ПС;
			КонецЦикла;
		КонецЕсли;
	Исключение
		ТекстРезультата = "Ошибка разбора XML (файл: " + ИмяФайла + "):" + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКонтрагентаУТ(Команда)
	СоздатьКонтрагентаУТНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьКонтрагентаУТНаСервере()
	Если Метаданные.Документы.Найти("РеализацияТоваровУслуг") = Неопределено Тогда
		ТекстРезультата = "Создание контрагента доступно только в УТ 11.5.";
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ИННПокупателя) Тогда
		ТекстРезультата = "Сначала разберите XML УПД.";
		Возврат;
	КонецЕсли;
	Попытка
		ПартнерСсылка = Справочники.Партнеры.НайтиПоНаименованию(НаименованиеПокупателя, Истина);
		Если ПартнерСсылка.Пустая() Тогда
			Партнер = Справочники.Партнеры.СоздатьЭлемент();
			Партнер.Наименование = НаименованиеПокупателя;
			Партнер.Записать();
			ПартнерСсылка = Партнер.Ссылка;
			ТекстРезультата = "Создан партнёр: " + НаименованиеПокупателя;
		Иначе
			ТекстРезультата = "Партнёр уже существует.";
		КонецЕсли;

		Ссылка = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИННПокупателя);
		Если Ссылка.Пустая() Тогда
			Элемент = Справочники.Контрагенты.СоздатьЭлемент();
			Элемент.Наименование = НаименованиеПокупателя;
			Элемент.ИНН = ИННПокупателя;
			Попытка Элемент.ЮридическоеФизическоеЛицо = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо"); Исключение КонецПопытки;
			Попытка Элемент.Партнер = ПартнерСсылка; Исключение КонецПопытки;
			Элемент.Записать();
			Ссылка = Элемент.Ссылка;
			ТекстРезультата = ТекстРезультата + Символы.ПС + "Создан контрагент: " + НаименованиеПокупателя;
		Иначе
			Элемент = Ссылка.ПолучитьОбъект();
			Попытка Элемент.ЮридическоеФизическоеЛицо = ПредопределенноеЗначение("Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо"); Исключение КонецПопытки;
			Попытка Элемент.Партнер = ПартнерСсылка; Исключение КонецПопытки;
			Элемент.Записать();
			ТекстРезультата = ТекстРезультата + Символы.ПС + "Контрагент найден, тип и связь с партнёром обновлены.";
		КонецЕсли;
		Попытка
			Партнер = ПартнерСсылка.ПолучитьОбъект();
			Партнер.ОсновнойКонтрагент = Ссылка;
			Партнер.Записать();
		Исключение
			// В некоторых вариантах УТ основной контрагент хранится только в карточке контрагента.
		КонецПопытки;
	Исключение
		ТекстРезультата = "Не удалось создать контрагента:" + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьПараметрыУТ(Команда)
	ПодобратьПараметрыУТНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПодобратьПараметрыУТНаСервере()
	Если ПустаяСтрока(ИННПродавца) И ПустаяСтрока(ИННПокупателя) Тогда
		ТекстРезультата = "Сначала выберите и разберите XML УПД.";
		Возврат;
	КонецЕсли;
	Если Метаданные.Документы.Найти("РеализацияТоваровУслуг") = Неопределено Тогда
		ТекстРезультата = "Подбор параметров доступен только в УТ 11.5.";
		Возврат;
	КонецЕсли;
	ТекстРезультата = "Автоматический подбор по ИНН:" + Символы.ПС;
	ТекстРезультата = ТекстРезультата + ПодобратьСсылку("Организации", "ИНН", ИННПродавца, "Организация") + Символы.ПС;
	ТекстРезультата = ТекстРезультата + ПодобратьПоНаименованию("Партнеры", НаименованиеПокупателя, "Партнёр") + Символы.ПС;
	ТекстРезультата = ТекстРезультата + ПодобратьСсылку("Контрагенты", "ИНН", ИННПокупателя, "Контрагент") + Символы.ПС;
	ТекстРезультата = ТекстРезультата + ПодобратьПоНаименованию("Номенклатура", "Товар из УПД", "Общий товар");
КонецПроцедуры

&НаСервере
Функция ПодобратьСсылку(ИмяСправочника, ИмяРеквизита, Значение, Заголовок)
	Попытка
		Ссылка = Справочники[ИмяСправочника].НайтиПоРеквизиту(ИмяРеквизита, Значение);
		Если Ссылка.Пустая() Тогда Возврат Заголовок + ": не найден"; КонецЕсли;
		Возврат Заголовок + ": найден (" + Строка(Ссылка) + ")";
	Исключение
		Возврат Заголовок + ": поиск недоступен";
	КонецПопытки;
КонецФункции

&НаСервере
Функция ПодобратьПоНаименованию(ИмяСправочника, Наименование, Заголовок)
	Попытка
		Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
		Если Ссылка.Пустая() Тогда Возврат Заголовок + ": не найден"; КонецЕсли;
		Возврат Заголовок + ": найден (" + Строка(Ссылка) + ")";
	Исключение
		Возврат Заголовок + ": поиск недоступен";
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура СоздатьРеализацию(Команда)
	ТекстРезультата = "Создание документа поддерживается только в 1С:Управление торговлей 11.5.";
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьМетаданныеУТ(Команда)
	ПроверитьМетаданныеУТНаСервере();
КонецПроцедуры

&НаСервере
Функция ДиагностическоеПредставлениеЗначения(Значение)
	Результат = "строка=[" + Строка(Значение) + "]; тип=" + Строка(ТипЗнч(Значение));
	Попытка
		Результат = Результат + "; XML=[" + XMLСтрока(Значение) + "]";
	Исключение
		Результат = Результат + "; XML=<ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ">";
	КонецПопытки;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ПроверитьМетаданныеУТНаСервере()
	ДокументМетаданные = Метаданные.Документы.Найти("РеализацияТоваровУслуг");
	Если ДокументМетаданные = Неопределено Тогда
		ТекстРезультата = "Документ РеализацияТоваровУслуг в этой конфигурации не найден.";
		Возврат;
	КонецЕсли;

	ТекстРезультата = "ДИАГНОСТИКА НДС УТ" + Символы.ПС;
	ТекстРезультата = ТекстРезультата + "Документ: " + ДокументМетаданные.Имя + Символы.ПС;
	ТекстРезультата = ТекстРезультата + Символы.ПС + "1. МЕТАДАННЫЕ КОЛОНКИ" + Символы.ПС;
	КолонкаСтавкиНДСНайдена = Ложь;
	Для каждого ТабличнаяЧасть Из ДокументМетаданные.ТабличныеЧасти Цикл
		Если ТабличнаяЧасть.Имя = "Товары" Тогда
			Для каждого Колонка Из ТабличнаяЧасть.Реквизиты Цикл
				Если Колонка.Имя = "СтавкаНДС" Тогда
					КолонкаСтавкиНДСНайдена = Истина;
					Попытка
						ТекстРезультата = ТекстРезультата + "Товары.СтавкаНДС, тип: " + Строка(Колонка.Тип) + Символы.ПС;
					Исключение
						ТекстРезультата = ТекстРезультата + "Товары.СтавкаНДС, тип: <ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ">" + Символы.ПС;
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Если Не КолонкаСтавкиНДСНайдена Тогда
		ТекстРезультата = ТекстРезультата + "Колонка Товары.СтавкаНДС не найдена." + Символы.ПС;
	КонецЕсли;

	ТекстРезультата = ТекстРезультата + Символы.ПС + "2. ЗНАЧЕНИЯ ПЕРЕЧИСЛЕНИЯ СтавкиНДС" + Символы.ПС;
	МетаданныеСтавок = Метаданные.Перечисления.Найти("СтавкиНДС");
	Если МетаданныеСтавок = Неопределено Тогда
		ТекстРезультата = ТекстРезультата + "Перечисление СтавкиНДС не найдено." + Символы.ПС;
	Иначе
		ТестовыйДокумент = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		ТестоваяСтрока = ТестовыйДокумент.Товары.Добавить();
		Для каждого МетаданныеСтавки Из МетаданныеСтавок.ЗначенияПеречисления Цикл
			ТекстРезультата = ТекстРезультата + "- имя=" + МетаданныеСтавки.Имя + "; синоним=[" + Строка(МетаданныеСтавки.Синоним) + "]" + Символы.ПС;
			Попытка
				ЗначениеСтавки = Перечисления.СтавкиНДС[МетаданныеСтавки.Имя];
				ТекстРезультата = ТекстРезультата + "  менеджер: " + ДиагностическоеПредставлениеЗначения(ЗначениеСтавки) + Символы.ПС;
				ТестоваяСтрока.СтавкаНДС = ЗначениеСтавки;
				ТекстРезультата = ТекстРезультата + "  после присваивания: " + ДиагностическоеПредставлениеЗначения(ТестоваяСтрока.СтавкаНДС) + Символы.ПС;
			Исключение
				ТекстРезультата = ТекстРезультата + "  ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	ТекстРезультата = ТекстРезультата + Символы.ПС + "3. ОБЩИЙ ТОВАР" + Символы.ПС;
	Попытка
		Товар = Справочники.Номенклатура.НайтиПоНаименованию("Товар из УПД", Истина);
		Если Товар.Пустая() Тогда
			ТекстРезультата = ТекстРезультата + "Товар из УПД не найден." + Символы.ПС;
		Иначе
			ОбъектТовара = Товар.ПолучитьОбъект();
			Попытка
				ТекстРезультата = ТекстРезультата + "СтавкаНДС товара: " + ДиагностическоеПредставлениеЗначения(ОбъектТовара.СтавкаНДС) + Символы.ПС;
			Исключение
				ТекстРезультата = ТекстРезультата + "Реквизит СтавкаНДС у товара недоступен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
			КонецПопытки;
		КонецЕсли;
	Исключение
		ТекстРезультата = ТекстРезультата + "Ошибка чтения товара: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
	КонецПопытки;

	ТекстРезультата = ТекстРезультата + Символы.ПС + "4. ПОСЛЕДНИЙ ДОКУМЕНТ" + Символы.ПС;
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		| Реализация.Ссылка КАК Ссылка
		|ИЗ
		| Документ.РеализацияТоваровУслуг КАК Реализация
		|УПОРЯДОЧИТЬ ПО
		| Реализация.Дата УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПоследнийДокумент = Выборка.Ссылка.ПолучитьОбъект();
			ТекстРезультата = ТекстРезультата + "Ссылка: " + Строка(Выборка.Ссылка) + Символы.ПС;
			ТекстРезультата = ТекстРезультата + "НалогообложениеНДС: " + ДиагностическоеПредставлениеЗначения(ПоследнийДокумент.НалогообложениеНДС) + Символы.ПС;
			НомерСтроки = 0;
			Для каждого СтрокаДокумента Из ПоследнийДокумент.Товары Цикл
				НомерСтроки = НомерСтроки + 1;
				ТекстРезультата = ТекстРезультата + "Строка " + Строка(НомерСтроки) + ", СтавкаНДС: " + ДиагностическоеПредставлениеЗначения(СтрокаДокумента.СтавкаНДС) + Символы.ПС;
			КонецЦикла;
		Иначе
			ТекстРезультата = ТекстРезультата + "Документы не найдены." + Символы.ПС;
		КонецЕсли;
	Исключение
		ТекстРезультата = ТекстРезультата + "Ошибка чтения документа: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
	КонецПопытки;
КонецПроцедуры

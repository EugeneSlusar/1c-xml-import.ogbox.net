&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РеквизитРезультат = Новый РеквизитФормы("ТекстРезультата", Новый ОписаниеТипов("Строка"));
	ИзменитьРеквизиты(Новый Массив(РеквизитРезультат));

	КомандаВыбрать = Команды.Добавить("ВыбратьXML");
	КомандаВыбрать.Действие = "ВыбратьXML";
	КомандаВыбрать.Заголовок = "Выбрать XML";

	КомандаСоздать = Команды.Добавить("СоздатьРеализацию");
	КомандаСоздать.Действие = "СоздатьРеализацию";
	КомандаСоздать.Заголовок = "Создать реализацию";
	КомандаСоздать.Доступность = Ложь;

	ЭлементРезультат = Элементы.Добавить("ТекстРезультата", Тип("ПолеФормы"));
	ЭлементРезультат.Вид = ВидПоляФормы.ПолеТекста;
	ЭлементРезультат.ПутьКДанным = "ТекстРезультата";
	ЭлементРезультат.МногострочныйРежим = Истина;
	ЭлементРезультат.РастягиватьПоГоризонтали = Истина;
	ЭлементРезультат.РастягиватьПоВертикали = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьXML(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Заголовок = "Выберите XML-файл УПД";
	Диалог.Фильтр = "XML-файлы (*.xml)|*.xml";
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораXML", ЭтотОбъект);
	Диалог.Показать(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораXML(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда Возврат; КонецЕсли;

	Попытка
		ДвоичныеДанные = Новый ДвоичныеДанные(ВыбранныеФайлы[0].ПолноеИмя);
		АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
		ПрочитатьXMLНаСервере(АдресФайла);
	Исключение
		ТекстРезультата = "Не удалось передать XML на сервер." + Символы.ПС + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПрочитатьXMLНаСервере(АдресФайла)
	Попытка
		Данные = Объект.РазобратьXMLИзВременногоХранилища(АдресФайла);
		ТекстРезультата = СформироватьТекстРезультата(Данные);
	Исключение
		ТекстРезультата = ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция СформироватьТекстРезультата(Данные)
	Текст = "УПД XML" + Символы.ПС + "=""=""=""=""=""=""=""=""=""=""=""=""=""=""=""=""=""=""=""=""=""=""="" + Символы.ПС;
	Текст = Текст + "Документ: №" + Данные.Document.DocumentNumber + " от " + Формат(Данные.Document.DocumentDate, "ДФ=dd.MM.yyyy") + Символы.ПС;
	Текст = Текст + "Функция: " + Данные.Document.Function + Символы.ПС;
	Текст = Текст + "Продавец: " + Данные.Seller.Name + Символы.ПС + "ИНН: " + Данные.Seller.INN + " КПП: " + Данные.Seller.KPP + Символы.ПС;
	Текст = Текст + "Покупатель: " + Данные.Buyer.Name + Символы.ПС + "ИНН: " + Данные.Buyer.INN + " КПП: " + Данные.Buyer.KPP + Символы.ПС;
	Текст = Текст + "Валюта: " + Данные.Document.CurrencyCode + " " + Данные.Document.CurrencyName + Символы.ПС;
	Текст = Текст + "Строк товаров: " + Данные.Items.Количество() + Символы.ПС + Символы.ПС;

	Для каждого Строка Из Данные.Items Цикл
		Текст = Текст + Строка.LineNumber + ". " + Строка.Name + Символы.ПС;
		Текст = Текст + Формат(Строка.Quantity, "ЧГ=15.3") + " " + Строка.UnitName + "; цена XML " + Формат(Строка.XmlPrice, "ЧГ=15.2") + Символы.ПС;
		Текст = Текст + "Без НДС: " + Формат(Строка.AmountWithoutVAT, "ЧГ=15.2") + "; НДС " + Строка.VATRate + " " + Формат(Строка.VATAmount, "ЧГ=15.2") + Символы.ПС;
		Текст = Текст + "С НДС: " + Формат(Строка.AmountWithVAT, "ЧГ=15.2") + Символы.ПС + Символы.ПС;
	КонецЦикла;

	Текст = Текст + "ИТОГИ" + Символы.ПС;
	Текст = Текст + "Без НДС: " + Формат(Данные.Totals.AmountWithoutVAT, "ЧГ=15.2") + Символы.ПС;
	Текст = Текст + "НДС: " + Формат(Данные.Totals.VATAmount, "ЧГ=15.2") + Символы.ПС;
	Текст = Текст + "С НДС: " + Формат(Данные.Totals.AmountWithVAT, "ЧГ=15.2") + Символы.ПС;

	Если Данные.Errors.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "ОШИБКИ ПРОВЕРКИ:" + Символы.ПС;
		Для каждого Ошибка Из Данные.Errors Цикл Текст = Текст + "- " + Ошибка + Символы.ПС; КонецЦикла;
	Иначе
		Текст = Текст + Символы.ПС + "Проверка обязательных полей: OK" + Символы.ПС;
	КонецЕсли;

	Текст = Текст + Символы.ПС + "Создание документа доступно только в 1С:Управление торговлей 11.5.";
	Возврат Текст;
КонецФункции

&НаКлиенте
Процедура СоздатьРеализацию(Команда)
	ТекстРезультата = "Создание документа доступно только в 1С:Управление торговлей 11.5.";
КонецПроцедуры

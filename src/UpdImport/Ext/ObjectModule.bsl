// XML Reader для УПД 5.03 / КНД 1115131 / СЧФДОП.
// Этот модуль не обращается к метаданным УНФ или УТ.

Функция РазобратьXMLИзВременногоХранилища(АдресФайла) Экспорт
	Если ПустаяСтрока(АдресФайла) Тогда
		ВызватьИсключение "Не передан адрес XML-файла во временном хранилище.";
	КонецЕсли;

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ДвоичныеДанные = Неопределено Тогда
		ВызватьИсключение "Не удалось получить XML-файл из временного хранилища.";
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ФайлЗаписан = Ложь;
	Попытка
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		ФайлЗаписан = Истина;
		Результат = РазобратьXMLИзФайла(ИмяВременногоФайла);
		УдалитьФайлы(ИмяВременногоФайла);
		Возврат Результат;
	Исключение
		Если ФайлЗаписан Тогда
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
КонецФункции

Функция РазобратьXMLИзФайла(ИмяФайла) Экспорт
	ЧтениеXML = Новый ЧтениеXML;
	ФайлОткрыт = Ложь;
	Попытка
		ЧтениеXML.ОткрытьФайл(ИмяФайла);
		ФайлОткрыт = Истина;
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		Результат = НормализоватьДокумент(ДокументDOM.ЭлементДокумента);
		ЧтениеXML.Закрыть();
		Возврат Результат;
	Исключение
		Если ФайлОткрыт Тогда
			ЧтениеXML.Закрыть();
		КонецЕсли;
		ВызватьИсключение "Не удалось прочитать XML. Проверьте, что выбран корректный файл УПД.";
	КонецПопытки;
КонецФункции

Функция НормализоватьДокумент(Корень) Экспорт
	ДокументУПД = НайтиУзел(Корень, "Документ");
	Если ДокументУПД = Неопределено Тогда
		ВызватьИсключение "В XML отсутствует узел ""Документ"".";
	КонецЕсли;

	СчетФактура = НайтиУзел(ДокументУПД, "СвСчФакт");
	Если СчетФактура = Неопределено Тогда
		ВызватьИсключение "В XML отсутствует узел ""СвСчФакт"".";
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Document", Новый Структура);
	Результат.Вставить("Seller", Новый Структура);
	Результат.Вставить("Buyer", Новый Структура);
	Результат.Вставить("Shipper", Новый Структура);
	Результат.Вставить("Consignee", Новый Структура);
	Результат.Вставить("Transfer", Новый Структура);
	Результат.Вставить("Items", Новый ТаблицаЗначений);
	Результат.Вставить("Totals", Новый Структура);

	Документ = Результат.Document;
	Документ.Вставить("XmlFileId", ЗначениеАтрибута(Корень, "ИдФайл"));
	Документ.Вставить("XmlVersion", ЗначениеАтрибута(Корень, "ВерсПрог"));
	Документ.Вставить("Function", ЗначениеАтрибута(СчетФактура, "Функция"));
	Если ПустаяСтрока(Документ.Function) Тогда Документ.Function = ЗначениеАтрибута(ДокументУПД, "Функция"); КонецЕсли;
	Документ.Вставить("DocumentNumber", ЗначениеАтрибута(СчетФактура, "НомерСчФ"));
	Документ.Вставить("DocumentDate", ПрочитатьДату(ЗначениеАтрибута(СчетФактура, "ДатаСчФ")));
	Если ПустаяСтрока(Документ.DocumentNumber) Тогда Документ.DocumentNumber = ЗначениеАтрибута(СчетФактура, "НомерДок"); КонецЕсли;
	Если Документ.DocumentDate = Неопределено Тогда Документ.DocumentDate = ПрочитатьДату(ЗначениеАтрибута(СчетФактура, "ДатаДок")); КонецЕсли;

	Валюта = НайтиУзел(СчетФактура, "СвВал");
	Если Валюта = Неопределено Тогда Валюта = НайтиУзел(СчетФактура, "ДенИзм"); КонецЕсли;
	Документ.Вставить("CurrencyCode", ЗначениеАтрибута(Валюта, "КодОКВ"));
	Документ.Вставить("CurrencyName", ЗначениеАтрибута(Валюта, "НаимОКВ"));

	Результат.Seller = РазобратьСторону(НайтиУзел(СчетФактура, "СвПрод"));
	Результат.Buyer = РазобратьСторону(НайтиУзел(СчетФактура, "СвПокуп"));
	Грузоотправитель = НайтиУзел(СчетФактура, "ГрузОтпр");
	Если Грузоотправитель = Неопределено Тогда Грузоотправитель = НайтиУзел(СчетФактура, "ГрузОт"); КонецЕсли;
	Результат.Shipper = РазобратьСторону(Грузоотправитель);
	Результат.Consignee = РазобратьСторону(НайтиУзел(СчетФактура, "ГрузПолуч"));

	Передача = НайтиУзел(ДокументУПД, "СвПродПер");
	Результат.Transfer.Вставить("Date", ПрочитатьДату(ЗначениеАтрибута(Передача, "ДатаПер")));
	Результат.Transfer.Вставить("OperationDescription", ЗначениеАтрибута(Передача, "СодОпер"));
	СвПер = НайтиУзел(Передача, "СвПер");
	Если Результат.Transfer.Date = Неопределено Тогда Результат.Transfer.Date = ПрочитатьДату(ЗначениеАтрибута(СвПер, "ДатаПер")); КонецЕсли;
	Если ПустаяСтрока(Результат.Transfer.OperationDescription) Тогда Результат.Transfer.OperationDescription = ЗначениеАтрибута(СвПер, "СодОпер"); КонецЕсли;

	Таблица = Результат.Items;
	Таблица.Колонки.Добавить("LineNumber");
	Таблица.Колонки.Добавить("Name");
	Таблица.Колонки.Добавить("OKEI");
	Таблица.Колонки.Добавить("UnitName");
	Таблица.Колонки.Добавить("Quantity");
	Таблица.Колонки.Добавить("XmlPrice");
	Таблица.Колонки.Добавить("AmountWithoutVAT");
	Таблица.Колонки.Добавить("VATRate");
	Таблица.Колонки.Добавить("VATAmount");
	Таблица.Колонки.Добавить("AmountWithVAT");

	ТаблицаСчФакт = НайтиУзел(ДокументУПД, "ТаблСчФакт");
	Если ТаблицаСчФакт <> Неопределено Тогда
		Для каждого УзелТовара Из НайтиДочерниеУзлы(ТаблицаСчФакт, "СведТов") Цикл
			Строка = Таблица.Добавить();
			Строка.LineNumber = ЗначениеАтрибута(УзелТовара, "НомСтр");
			Строка.Name = ЗначениеАтрибута(УзелТовара, "НаимТов");
			Строка.OKEI = ЗначениеАтрибута(УзелТовара, "ОКЕИ");
			Если ПустаяСтрока(Строка.OKEI) Тогда Строка.OKEI = ЗначениеАтрибута(УзелТовара, "ОКЕИ_Тов"); КонецЕсли;
			Строка.UnitName = ЗначениеАтрибута(УзелТовара, "НаимЕд");
			Если ПустаяСтрока(Строка.UnitName) Тогда Строка.UnitName = ЗначениеАтрибута(УзелТовара, "НаимЕдИзм"); КонецЕсли;
			Строка.Quantity = ПрочитатьЧисло(ЗначениеАтрибута(УзелТовара, "КолТов"));
			Строка.XmlPrice = ПрочитатьЧисло(ЗначениеАтрибута(УзелТовара, "ЦенаТов"));
			Строка.AmountWithoutVAT = ПрочитатьЧисло(ЗначениеАтрибута(УзелТовара, "СтТовБезНДС"));
			Строка.VATRate = ЗначениеАтрибута(УзелТовара, "НалСт");
			Строка.VATAmount = ПрочитатьЧисло(ЗначениеАтрибута(УзелТовара, "НалСум"));
			Если Строка.VATAmount = Неопределено Тогда Строка.VATAmount = ПрочитатьЧисло(ЗначениеАтрибута(НайтиУзел(УзелТовара, "СумНал"), "СумНал")); КонецЕсли;
			Строка.AmountWithVAT = ПрочитатьЧисло(ЗначениеАтрибута(УзелТовара, "СтТовУчНал"));
		КонецЦикла;
	КонецЕсли;

	Всего = НайтиУзел(ДокументУПД, "ВсегоОпл");
	Результат.Totals.Вставить("AmountWithoutVAT", ПрочитатьЧисло(ЗначениеАтрибута(Всего, "СтТовБезНДС")));
	Результат.Totals.Вставить("VATAmount", ПрочитатьЧисло(ЗначениеАтрибута(Всего, "НалСумВсего")));
	Результат.Totals.Вставить("AmountWithVAT", ПрочитатьЧисло(ЗначениеАтрибута(Всего, "СтТовУчНал")));
	Если Результат.Totals.AmountWithoutVAT = Неопределено Тогда Результат.Totals.AmountWithoutVAT = ПрочитатьЧисло(ЗначениеАтрибута(Всего, "СтТовБезНДСВсего")); КонецЕсли;
	Если Результат.Totals.AmountWithVAT = Неопределено Тогда Результат.Totals.AmountWithVAT = ПрочитатьЧисло(ЗначениеАтрибута(Всего, "СтТовУчНалВсего")); КонецЕсли;
	Если Результат.Totals.VATAmount = Неопределено Тогда Результат.Totals.VATAmount = ПрочитатьЧисло(ЗначениеАтрибута(НайтиУзел(Всего, "СумНалВсего"), "СумНал")); КонецЕсли;

	Результат.Вставить("Errors", ПроверитьНормализованныйДокумент(Результат));
	Возврат Результат;
КонецФункции

Функция РазобратьСторону(УзелСтороны)
	Сторона = Новый Структура;
	Сторона.Вставить("Name", ЗначениеАтрибута(УзелСтороны, "НаимОрг"));
	Сторона.Вставить("INN", ЗначениеАтрибута(УзелСтороны, "ИННЗнач"));
	Сторона.Вставить("KPP", ЗначениеАтрибута(УзелСтороны, "КППЗнач"));
	Сторона.Вставить("Address", ЗначениеАтрибута(НайтиУзел(УзелСтороны, "АдрИнф"), "АдрТекст"));
	Банк = НайтиУзел(УзелСтороны, "БанкРекв");
	Сторона.Вставить("BankAccount", ЗначениеАтрибута(Банк, "НомерСчета"));
	СвБанк = НайтиУзел(Банк, "СвБанк");
	Сторона.Вставить("BankName", ЗначениеАтрибута(СвБанк, "НаимБанк"));
	Сторона.Вставить("BIK", ЗначениеАтрибута(СвБанк, "БИК"));
	Если ПустаяСтрока(Сторона.Name) Тогда Сторона.Name = ЗначениеАтрибута(УзелСтороны, "СокрНаим"); КонецЕсли;

	Сведения = НайтиУзел(УзелСтороны, "СвЮЛ");
	Если Сведения = Неопределено Тогда Сведения = НайтиУзел(УзелСтороны, "СвЮЛУч"); КонецЕсли;
	Если Сведения <> Неопределено Тогда
		Если ПустаяСтрока(Сторона.Name) Тогда Сторона.Name = ЗначениеАтрибута(Сведения, "НаимОрг"); КонецЕсли;
		Если ПустаяСтрока(Сторона.INN) Тогда Сторона.INN = ЗначениеАтрибута(Сведения, "ИННЗнач"); КонецЕсли;
		Если ПустаяСтрока(Сторона.KPP) Тогда Сторона.KPP = ЗначениеАтрибута(Сведения, "КППЗнач"); КонецЕсли;
		Если ПустаяСтрока(Сторона.INN) Тогда Сторона.INN = ЗначениеАтрибута(Сведения, "ИННЮЛ"); КонецЕсли;
		Если ПустаяСтрока(Сторона.KPP) Тогда Сторона.KPP = ЗначениеАтрибута(Сведения, "КПП"); КонецЕсли;
	КонецЕсли;
	Возврат Сторона;
КонецФункции

Функция ПроверитьНормализованныйДокумент(Данные)
	Ошибки = Новый Массив;
	Если ПустаяСтрока(Данные.Document.DocumentNumber) Тогда Ошибки.Добавить("В XML отсутствует номер документа."); КонецЕсли;
	Если Данные.Document.DocumentDate = Неопределено Тогда Ошибки.Добавить("В XML отсутствует дата документа."); КонецЕсли;
	Если ПустаяСтрока(Данные.Seller.INN) Тогда Ошибки.Добавить("У продавца отсутствует ИНН."); КонецЕсли;
	Если ПустаяСтрока(Данные.Buyer.INN) Тогда Ошибки.Добавить("У покупателя отсутствует ИНН."); КонецЕсли;
	Если Данные.Items.Количество() = 0 Тогда Ошибки.Добавить("В XML отсутствуют строки товаров или услуг."); КонецЕсли;

	Если ЗначениеЗаполнено(Данные.Totals.AmountWithoutVAT)
		И ЗначениеЗаполнено(Данные.Totals.VATAmount)
		И ЗначениеЗаполнено(Данные.Totals.AmountWithVAT) Тогда
		Если Окр(Данные.Totals.AmountWithoutVAT + Данные.Totals.VATAmount, 2) <> Окр(Данные.Totals.AmountWithVAT, 2) Тогда
			Ошибки.Добавить("Итоги XML не сходятся: Без НДС + НДС не равно С НДС.");
		КонецЕсли;
	КонецЕсли;
	Возврат Ошибки;
КонецФункции

Функция НайтиУзел(Корень, ИмяУзла)
	Если Корень = Неопределено Тогда Возврат Неопределено; КонецЕсли;
	Если НормализоватьИмя(Корень.ИмяУзла) = ИмяУзла Тогда Возврат Корень; КонецЕсли;
	Для каждого Узел Из Корень.ДочерниеУзлы Цикл
		Результат = НайтиУзел(Узел, ИмяУзла);
		Если Результат <> Неопределено Тогда Возврат Результат; КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция НайтиДочерниеУзлы(Корень, ИмяУзла)
	Результат = Новый Массив;
	Если Корень = Неопределено Тогда Возврат Результат; КонецЕсли;
	Для каждого Узел Из Корень.ДочерниеУзлы Цикл
		Если НормализоватьИмя(Узел.ИмяУзла) = ИмяУзла Тогда Результат.Добавить(Узел); КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НормализоватьИмя(Имя)
	Если Имя = Неопределено Тогда Возврат ""; КонецЕсли;
	Позиция = СтрНайти(Имя, ":");
	Если Позиция > 0 Тогда Возврат Сред(Имя, Позиция + 1); КонецЕсли;
	Возврат Имя;
КонецФункции

Функция ЗначениеАтрибута(Узел, ИмяАтрибута)
	Если Узел = Неопределено Тогда Возврат ""; КонецЕсли;
	Попытка
		Атрибут = Узел.Атрибуты.ПолучитьИменованныйЭлемент(ИмяАтрибута);
		Если Атрибут <> Неопределено Тогда
			Возврат СокрЛП(Атрибут.Значение);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат СокрЛП(ТекстУзла(НайтиУзел(Узел, ИмяАтрибута)));
КонецФункции

Функция ТекстУзла(Узел)
	Если Узел = Неопределено Тогда Возврат ""; КонецЕсли;
	Попытка Возврат СокрЛП(Узел.ТекстовоеСодержимое); Исключение КонецПопытки;
	Возврат "";
КонецФункции

Функция ПрочитатьЧисло(Текст)
	Если ПустаяСтрока(Текст) Тогда Возврат Неопределено; КонецЕсли;
	Попытка Возврат Число(СтрЗаменить(СтрЗаменить(СокрЛП(Текст), " ", ""), ".", ",")); Исключение Возврат Неопределено; КонецПопытки;
КонецФункции

Функция ПрочитатьДату(Текст)
	Если ПустаяСтрока(Текст) Тогда Возврат Неопределено; КонецЕсли;
	Части = СтрРазделить(СокрЛП(Текст), "-");
	Если Части.Количество() = 3 Тогда
		Попытка Возврат Дата(Число(Части[0]), Число(Части[1]), Число(Части[2])); Исключение КонецПопытки;
	КонецЕсли;
	Части = СтрРазделить(СокрЛП(Текст), ".");
	Если Части.Количество() = 3 Тогда
		Попытка Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0])); Исключение КонецПопытки;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции
